<Window x:Class="FolderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder App" Height="600" Width="400" Background="#1E1E2E">

    <Window.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">

        <!-- The folder tiles are now built in code -->
        <WrapPanel x:Name="FoldersPanel" Margin="20"/>

        <!-- The popup that zooms open (hidden at first) -->
        <Border x:Name="Overlay" Margin="30" Background="#2B2B40" CornerRadius="24"
                Opacity="0" IsHitTestVisible="False"
                MouseLeftButtonDown="Overlay_MouseDown">
            <Border.RenderTransform>
                <ScaleTransform x:Name="Scale" ScaleX="0.1" ScaleY="0.1"/>
            </Border.RenderTransform>
            <DockPanel Margin="24">
                <Button Content="+ Add app" DockPanel.Dock="Bottom"
                        Margin="0,12,0,0" Padding="8" Click="Add_Click"/>
                <WrapPanel x:Name="ItemsPanel"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>